# Dockerfile.reviewer
#
# Installs ONLY the prerequisites a reviewer needs to follow the
# "Using Redpanda's Dynamic Plugins" tutorial from scratch.
#
# What is installed (prerequisites):
#   - Python 3.12       (runtime for plugin subprocesses, SDK requires >=3.12)
#   - uv                (Python package manager used by the tutorial)
#   - rpk               (Redpanda CLI, provides `rpk connect run`)
#   - curl, unzip       (fetch tools)
#
# What is NOT installed (tutorial artifacts, the reader creates these):
#   - plugins/ directory
#   - yell_processor.py
#   - plugin.yaml / connect.yaml
#   - redpanda_connect Python package (installed via uv inside the tutorial)
#
# Build:
#   docker build -f Dockerfile.reviewer -t rpconnect-reviewer .
# Run:
#   docker run -it --rm rpconnect-reviewer bash

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# System packages (Ubuntu 24.04 ships Python 3.12 natively)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# uv (Python package manager recommended by Redpanda Connect docs)
# ---------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# ---------------------------------------------------------------------------
# rpk (Redpanda CLI, provides `rpk connect run --rpc-plugins`)
# Detects architecture automatically (amd64 or arm64)
# ---------------------------------------------------------------------------
RUN ARCH=$(dpkg --print-architecture) && \
    curl -L \
    "https://github.com/redpanda-data/redpanda/releases/latest/download/rpk-linux-${ARCH}.zip" \
    -o /tmp/rpk.zip && \
    unzip /tmp/rpk.zip -d /usr/local/bin/ && \
    chmod +x /usr/local/bin/rpk && \
    rm /tmp/rpk.zip

# ---------------------------------------------------------------------------
# Verify installations
# ---------------------------------------------------------------------------
RUN python3 --version && \
    uv --version && \
    rpk version

# ---------------------------------------------------------------------------
# Working directory
# ---------------------------------------------------------------------------
WORKDIR /tutorial

CMD ["bash"]
